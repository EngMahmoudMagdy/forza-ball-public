rules_version = '2';
// Deploy: `firebase deploy --only firestore:rules` (see firebase.json) or Console → Firestore → Rules → Publish.
// Enable Firestore: Console → Build → Firestore → Create database (start in production or test mode, then paste these rules).
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /posts/{postId} {
      allow read: if true;
      // Must match client: userId must be the signed-in user (see FeedRepositoryImpl.createPost).
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      // Author can edit; others may only change counters (likes/comments) on the same content.
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.userId
        || (
          request.resource.data.userId == resource.data.userId
          && request.resource.data.text == resource.data.text
          && request.resource.data.timestamp == resource.data.timestamp
        )
      );
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;

      match /likes/{likeUserId} {
        allow read: if true;
        allow create, delete: if request.auth != null && request.auth.uid == likeUserId;
      }

      match /dislikes/{dislikeUserId} {
        allow read: if true;
        allow create, delete: if request.auth != null && request.auth.uid == dislikeUserId;
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null;
        allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;

        match /commentLikes/{likeUid} {
          allow read: if true;
          allow create, delete: if request.auth != null && request.auth.uid == likeUid;
        }
      }
    }

    match /follows/{followId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /feeds/{feedUserId} {
      allow read: if request.auth != null && request.auth.uid == feedUserId;
      allow write: if false;
    }
  }
}
