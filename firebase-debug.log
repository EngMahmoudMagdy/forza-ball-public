[debug] [2026-05-16T20:25:03.123Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/forza-ball/rulesets {"name":"projects/forza-ball/rulesets/9717f36c-03b0-4bd6-a74a-db39ad98ba53","source":{"files":[{"content":"rules_version = '2';\n// Deploy: `firebase deploy --only firestore:rules` (see firebase.json) or Console → Firestore → Rules → Publish.\n// Enable Firestore: Console → Build → Firestore → Create database (start in production or test mode, then paste these rules).\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    match /users/{userId} {\n      allow read: if true;\n      allow create, update: if request.auth != null && request.auth.uid == userId;\n      allow delete: if request.auth != null && request.auth.uid == userId;\n\n      match /notifications/{notificationId} {\n        allow read: if request.auth != null && request.auth.uid == userId;\n        allow create: if request.auth != null\n          && request.resource.data.actorUserId == request.auth.uid\n          && userId != request.auth.uid\n          && request.resource.data.type == 'comment'\n          && request.resource.data.postId is string\n          && request.resource.data.read == false;\n        allow update, delete: if request.auth != null && request.auth.uid == userId;\n      }\n\n      match /savedPosts/{postId} {\n        allow read: if request.auth != null && request.auth.uid == userId;\n        allow create, delete: if request.auth != null && request.auth.uid == userId;\n      }\n    }\n\n    match /postReports/{reportId} {\n      allow create: if request.auth != null\n        && request.resource.data.reporterUserId == request.auth.uid\n        && request.resource.data.postId is string\n        && request.resource.data.reasonId is string;\n      allow read, update, delete: if false;\n    }\n\n    match /posts/{postId} {\n      allow read: if true;\n      // Must match client: userId must be the signed-in user (see FeedRepositoryImpl.createPost).\n      allow create: if request.auth != null\n        && request.resource.data.userId == request.auth.uid\n        && request.resource.data.isDeleted == false;\n      // Author soft-delete; others may only change counters on active (non-deleted) posts.\n      allow update: if request.auth != null && resource.data.isDeleted != true && (\n        (\n          request.auth.uid == resource.data.userId\n          && request.resource.data.userId == resource.data.userId\n          && request.resource.data.text == resource.data.text\n          && request.resource.data.timestamp == resource.data.timestamp\n          && request.resource.data.isDeleted == true\n          && request.resource.data.deletedAt is timestamp\n        )\n        || (\n          request.resource.data.userId == resource.data.userId\n          && request.resource.data.text == resource.data.text\n          && request.resource.data.timestamp == resource.data.timestamp\n          && request.resource.data.isDeleted == resource.data.isDeleted\n        )\n      );\n      // Hard delete is performed by Cloud Functions after retention period.\n      allow delete: if false;\n\n      match /likes/{likeUserId} {\n        allow read: if true;\n        allow create, delete: if request.auth != null && request.auth.uid == likeUserId;\n      }\n\n      match /dislikes/{dislikeUserId} {\n        allow read: if true;\n        allow create, delete: if request.auth != null && request.auth.uid == dislikeUserId;\n      }\n\n      match /comments/{commentId} {\n        allow read: if true;\n        allow create: if request.auth != null;\n        // Author edits body; anyone signed in may bump reaction counters (like dislikeCount) only.\n        allow update: if request.auth != null && (\n          request.auth.uid == resource.data.userId\n          || (\n            request.resource.data.userId == resource.data.userId\n            && request.resource.data.text == resource.data.text\n            && request.resource.data.timestamp == resource.data.timestamp\n          )\n        );\n        allow delete: if request.auth != null && (\n          request.auth.uid == resource.data.userId\n          || request.auth.uid == get(/databases/$(database)/documents/posts/$(postId)).data.userId\n        );\n\n        match /commentLikes/{likeUid} {\n          allow read: if true;\n          allow create, delete: if request.auth != null && request.auth.uid == likeUid;\n        }\n\n        match /commentDislikes/{dislikeUid} {\n          allow read: if true;\n          allow create, delete: if request.auth != null && request.auth.uid == dislikeUid;\n        }\n      }\n    }\n\n    match /follows/{followId} {\n      allow read: if true;\n      allow write: if request.auth != null;\n    }\n\n    match /feeds/{feedUserId} {\n      allow read: if request.auth != null && request.auth.uid == feedUserId;\n      allow write: if false;\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-05-16T20:25:03.010143Z","metadata":{"services":["cloud.firestore"]}}
