<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Opt out of mandatory edge-to-edge on API 35+ so content stays below status / above nav bar. -->
    <style name="Theme.ForzaBall" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
    </style>

    <!-- Shown when app icon is clicked until Compose draws -->
    <style name="Theme.ForzaBall.Splash" parent="Theme.ForzaBall">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>